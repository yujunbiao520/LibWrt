# Target System
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_asus_rt-ax89x=y

# NSS Offloading
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y

# LUCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Basic packages
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE-coreutils-nohup=y
CONFIG_PACKAGE-bash=y
CONFIG_PACKAGE-curl=y
CONFIG_PACKAGE-opkg=y
CONFIG_PACKAGE-wget=y
CONFIG_PACKAGE-tmux=y
CONFIG_PACKAGE-usb-modeswitch=y
CONFIG_PACKAGE-usb-net=y
CONFIG_PACKAGE-usb-net-rtl8152=y
CONFIG_PACKAGE-usb-storage=y
CONFIG_PACKAGE-kmod-usb-ohci=y
CONFIG_PACKAGE-kmod-usb-uhci=y
CONFIG_PACKAGE-kmod-usb2=y
CONFIG_PACKAGE-kmod-usb3=y

# Filesystem
CONFIG_PACKAGE-e2fsprogs=y
CONFIG_PACKAGE-fdisk=y
CONFIG_PACKAGE-lsblk=y

# WiFi
CONFIG_PACKAGE-kmod-ath11k=y
CONFIG_PACKAGE-kmod-ath11k-pci=y
CONFIG_ATH11K_FW_TYPE=y
CONFIG_ATH11K_FW_QCN9074_HW2_1=y

# WAN/LAN
CONFIG_PACKAGE-qosify=y

# IPv6
CONFIG_PACKAGE-odhcp6c=y
CONFIG_PACKAGE-odhcpd-ipv6only=y

# Firewall
CONFIG_PACKAGE-firewall=y
CONFIG_PACKAGE-firewall4=y

# Kernel modules
CONFIG_PACKAGE-kmod-nls-base=y
CONFIG_PACKAGE-kmod-usb-core=y
CONFIG_PACKAGE-kmod-usb-storage=y
CONFIG_PACKAGE-kmod-fs-ext4=y

# Image options
CONFIG_TARGET_ROOTFS_PARTSIZE=104
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
